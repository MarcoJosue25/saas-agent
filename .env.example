# Copia este archivo como .env y cambia los valores

# Base de datos (docker compose las usa para crear MySQL)
DB_USER=saas_agent
DB_PASSWORD=cambia_esta_clave
DB_ROOT_PASSWORD=cambia_esta_clave_root

# La app las lee del entorno, no del .env
DB_URL=jdbc:mysql://localhost:3310/negocios_saasagent
GCP_PROJECT_ID=tu-proyecto
GEMINI_MODEL=gemini-3.5-flash-lite

